{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure-project",
            "type": "shell",
            "command": "mkdir -p build && cd build && cmake -DCMAKE_CXX_COMPILER=g++ -DNO_KAHIP=True ..",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },//控制任务输出的显示方式
            "problemMatcher": []
        },
        {
            "label": "build-project",
            "type": "shell",
            "command": "cd build && make clean && make -j8",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": "configure-project"
        },
        {
            "label": "full-build",
            "type": "shell",
            "command": "rm -rf build_release && mkdir -p build_release && cd build_release && cmake -DCMAKE_CXX_COMPILER=g++ -DNO_KAHIP=True .. && make clean && make -j16",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "full-debug-build",
            "type": "shell",
            "command": "rm -rf build_debug && mkdir -p build_debug && cd build_debug && cmake -DCMAKE_BUILD_TYPE=Debug -DMPM_BUILD_TESTING=OFF -DCMAKE_CXX_COMPILER=g++ -DNO_KAHIP=True .. && make clean && make -j16",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run-mpm-demo-release",
            "type": "shell",
            "command": "~/mpm/build_release/mpm -f ~/mpm/demo/ -p 24 -i mpm.json",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}/build_release"
            },
            "problemMatcher": []
        },
        {
            "label": "run-mpm-demo-debug",
            "type": "shell",
            "command": "~/mpm/build_debug/mpm -f ~/mpm/demo/ -p 16 -i mpm.json",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}/build_debug"
            },
            "problemMatcher": []
        }
    ]
}