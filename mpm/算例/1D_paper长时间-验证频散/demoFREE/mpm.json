{
    "title": "1D_paper",
        
    "mesh":{
        "mesh": "mesh.txt",
        "entity_sets": "entity_sets.json",
        "particles_volumes": "particles-volumes.txt", 
        "particles_stresses": {
          "type": "isotropic",
          "values": [
            0.000000,
            0.000000,
            0.000000,
            0.000000,
            0.000000,
            0.000000
          ]
        },
        "particle_cells":"particles-cells.txt",
        "cell_type": "ED2Q4",
        "isoparametric": false,
        "check_duplicates": false,
        "io_type": "Ascii2D",
        "node_type": "N2D"
    },
    "particles": [
        {
            "generator": {
                "check_duplicates": true,
                "pset_id": 1,
                "material_id": 0,
                "particle_type": "P2D",
                "type": "file",
                "location": "particles.txt",
                "io_type": "Ascii2D"
            }
        }
        
    ],

    "materials": [
        {
            "id": 0,
            "type": "LinearElastic2D",
            "density": 1800.0,
            "youngs_modulus": 100000.0,
            "poisson_ratio": 0.0
        }
    ],

    "material_sets": [
        {
            "material_id": 0,
            "pset_id": 1
        }
    ],

    "external_loading_conditions": {
        "gravity": [0.0, 0.0],
        "particle_surface_traction": [
        {
          "pset_id": 0,
          "math_function_id": 0,
          "dir": 1,
          "traction": 0.01
        }
      ]
    },

    "math_functions": [
        {
            "id": 0,
            "type": "Linear",
            "file": "math_function_input.csv"
        },
        {
            "id": 10,
            "type": "Linear",
            "xvalues": [0.0, 1.0, 10.0],
            "fxvalues": [0.0, 10.0, 100.0]
        }
    ],

    "analysis": {
        "type": "MPMExplicit2D",
        "mpm_scheme": "usf",
        "velocity_update": "flip",
        "velocity_update_settings": {
	        "blending_ratio": 0.95
        },
        "dt": 5.0e-5,
        "nsteps": 40000,
        "locate_particles": true,
        "nload_balance_steps": 1000,
        "uuid": "output-name-000",
        "resume": {
            "resume": false,
            "uuid": "output-name-000",
            "step": 1000
        }
    },

    "post_processing":{
        "output_steps": 10,
        "path": "results/",
        "vtk": [ "velocities", "displacements", "volumes", "stresses" ],
        "vtk_statevars": [
            {
                "phase_id": 0,
                "statevars": [ "velocities", "displacements", "volumes", "stresses" ]
            }
        ]
    }

}